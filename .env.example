# ============================================
# VIVE MÁS INMOBILIARIA — VARIABLES DE ENTORNO
# ============================================
# Copia este archivo a .env y llena los valores reales.
# NUNCA subas .env a un repositorio público.

# ---- Servidor ----
PORT=5000
NODE_ENV=development
# URL pública del sitio (para health check interno)
SELF_URL=localhost

# ---- Base de datos MongoDB (Atlas recomendado) ----
MONGODB_URI=mongodb://localhost:27017/vive-mas

# ---- JWT ----
JWT_SECRET=cambia-este-secreto
JWT_REFRESH_SECRET=cambia-este-secreto-refresh

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=tu-cloud
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ---- Twilio (SMS / verificación) ----
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxx

# ---- Hostinger (opcional, para monitoreo de hosting) ----
# Requiere plan con acceso API. Sin esto, el panel muestra "No disponible".
HOSTINGER_API_KEY=

# ---- Alertas al administrador (opcional) ----
ADMIN_ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Backups (opcional) ----
# Ruta donde se guardan los backups (mongodump) y habilitar cron
BACKUP_PATH=
BACKUP_CRON=0
