# ==========================================================================
# vive-mas-inmobiliaria - .env.example (v1 parcial)
# --------------------------------------------------------------------------
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio (debe estar en .gitignore).
#
# Nota: se completa al 100% cuando se revisen todos los modulos del codigo
# (app.js, controladores, servicios). Los nombres marcados con (confirmar)
# deben validarse contra los process.env.* reales del proyecto.
# ==========================================================================

# --- Entorno ---------------------------------------------------------------
NODE_ENV=development          # development | production
PORT=3000

# --- OBLIGATORIAS ----------------------------------------------------------
# Sin estas la app no puede operar de forma completa.
MONGODB_URI=mongodb://127.0.0.1:27017/vive-mas

# Secretos de firma JWT. Genera valores fuertes y distintos entre si:
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- CORS -------------------------------------------------------------------
# URL(s) del frontend en produccion. Si falta, el backend aplica mismo-origen
# como maximo (nunca '*') y los servicios opcionales quedan degradados.
# Admite VARIOS origenes separados por coma:
# CLIENT_URL=https://vivemas.com,https://admin.vivemas.com
CLIENT_URL=http://localhost:5500

# --- CSP en modo reporte (opcional, app.js v5.1) -----------------------------
# Telemetria de migracion a CSP estricta: registra en la CONSOLA del navegador
# los scripts/estilos inline que violarian la politica future. NO bloquea nada.
# Dejalo sin definir (o en 0) para mantener la consola limpia.
#CSP_REPORTE=1

# --- Pagos: Stripe (opcional) -----------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Chatbot IA: Groq (opcional) --------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxx

# --- Correo: Nodemailer/SMTP (opcional) — nombres (confirmar) ---------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Vive Mas <no-reply@tudominio.com>"

# --- SMS: Twilio (opcional) — nombres (confirmar) ---------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+52xxxxxxxxxx

# --- Imagenes: Cloudinary (opcional) — nombres (confirmar) ------------------
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxx

# --- Avanzado: reintentos de conexion a MongoDB (opcional) -------------------
# Por defecto: 8 intentos iniciales con backoff (2s-30s) y luego reintento de
# fondo cada 60s sin tumbar la app. Solo ajústalos si sabes que lo necesitas.
#DB_RETRY_MAX=8
#DB_RETRY_BASE_MS=2000
#DB_RETRY_FOREVER_MS=60000
